# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jobbridge
DB_PASSWORD=change-me
DB_NAME=jobbridge

# --- Server ---
PORT=3001
SESSION_SECRET=change-me-long-random-string

# --- LLM provider: "claude" or "gemini" ---
LLM_PROVIDER=claude

# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ingestion ---
INGEST_INTERVAL_MINUTES=30
# Nightly outreach link re-verification schedule (UTC cron, default 01:15 UTC)
OUTREACH_REVERIFY_CRON_UTC=15 1 * * *
# Nightly outreach follow-up due audit schedule (UTC cron, default 01:30 UTC)
OUTREACH_FOLLOWUP_AUDIT_CRON_UTC=30 1 * * *

# --- GitHub enrichment (CV quality score) ---
# Optional but recommended: raises the unauthenticated GitHub API rate limit.
GITHUB_TOKEN=

# --- Outreach seed (optional) ---
# If set, `npm run seed` also loads config/outreach_contacts.json into this
# user's outreach list (creating the account if it doesn't exist yet).
SEED_USER_EMAIL=
